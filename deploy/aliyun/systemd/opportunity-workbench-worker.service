[Unit]
Description=Opportunity Workbench Taobao worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=workbench
Group=workbench
WorkingDirectory=__APP_ROOT__
EnvironmentFile=/etc/opportunity-workbench/workbench.env
Environment=PYTHONUNBUFFERED=1
Environment=WORKBENCH_DB=/var/lib/opportunity-workbench/workbench.sqlite3
ExecStart=__APP_ROOT__/.venv/bin/python -B app.py taobao-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/opportunity-workbench

[Install]
WantedBy=multi-user.target
