[Unit]
Description=Opportunity Workbench SQLite backup
After=opportunity-workbench-web.service

[Service]
Type=oneshot
User=workbench
Group=workbench
WorkingDirectory=__APP_ROOT__
EnvironmentFile=__APP_ROOT__/.runtime/workbench.env
Environment=WORKBENCH_DB=__APP_ROOT__/.runtime/workbench.sqlite3
Environment=WORKBENCH_BACKUP_DIR=__APP_ROOT__/.runtime/backups
ExecStart=__APP_ROOT__/.venv/bin/python -B deploy/aliyun/scripts/backup_sqlite.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=__APP_ROOT__/.runtime
