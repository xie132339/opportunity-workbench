# Copy to /etc/opportunity-workbench/workbench.env. Keep this file mode 0640.
# Use a unique long random value. Do not copy development .env files to the server.
WORKBENCH_SECRET=replace-with-a-server-only-random-secret
# Public deployment requires a private password chosen by the operator.
WORKBENCH_ADMIN_USERNAME=admin
WORKBENCH_ADMIN_PASSWORD=replace-with-a-private-server-password

# Supply only after the official Taobao Alliance application is approved.
TAOBAO_ALLIANCE_APP_KEY=
TAOBAO_ALLIANCE_APP_SECRET=
TAOBAO_ALLIANCE_ADZONE_ID=
TAOBAO_DETAIL_BATCH_LIMIT=20
