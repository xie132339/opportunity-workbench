CHANGED_API_BASE=http://127.0.0.1:5001
CHANGED_API_TOKEN=replace-with-local-monitor-api-key
WORKBENCH_SECRET=replace-with-random-local-secret
# Optional local login overrides. When omitted, the local default account is admin.
# WORKBENCH_ADMIN_USERNAME=admin
# WORKBENCH_ADMIN_PASSWORD=replace-with-your-local-password

# External notifications are opt-in and require your own receiving accounts.
NOTIFY_ENABLED=0
NOTIFY_CHANNELS=wecom,serverchan,qq_onebot
WECOM_WEBHOOK_URL=
SERVERCHAN_SENDKEY=
QQ_ONEBOT_BASE=http://127.0.0.1:3000
QQ_ONEBOT_TOKEN=
QQ_GROUP_ID=
QQ_USER_ID=

# Optional local source services, run from their own source worktrees.
RSSHUB_BASE=http://127.0.0.1:1200
GOOFISH_BASE=http://127.0.0.1:8000
GOOFISH_API_USER=
GOOFISH_API_PASSWORD=

# Optional Taobao Alliance TOP API connector. Configure your own approved app
# credentials and adzone before enabling a source; never commit real values.
TAOBAO_ALLIANCE_APP_KEY=
TAOBAO_ALLIANCE_APP_SECRET=
TAOBAO_ALLIANCE_ADZONE_ID=
# Per scan, validate at most this many fresh official material candidates.
# This controls SKU-detail validation only; official material pagination remains 100 per page until exhausted.
TAOBAO_DETAIL_BATCH_LIMIT=20
